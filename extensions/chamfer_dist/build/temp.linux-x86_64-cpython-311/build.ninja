ninja_required_version = 1.3
cxx = /apps/easybuild-2022/easybuild/software/Core/GCCcore/11.3.0/bin/g++
nvcc = /apps/easybuild-2022/easybuild/software/Core/CUDA/12.4.1/bin/nvcc

cflags = -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /data/gpfs/projects/punim2997/conda_envs/cfcpose/include -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /data/gpfs/projects/punim2997/conda_envs/cfcpose/include -fPIC -I/data/gpfs/projects/punim2997/conda_envs/cfcpose/lib/python3.11/site-packages/torch/include -I/data/gpfs/projects/punim2997/conda_envs/cfcpose/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/data/gpfs/projects/punim2997/conda_envs/cfcpose/lib/python3.11/site-packages/torch/include/TH -I/data/gpfs/projects/punim2997/conda_envs/cfcpose/lib/python3.11/site-packages/torch/include/THC -I/apps/easybuild-2022/easybuild/software/Core/CUDA/12.4.1/include -I/data/gpfs/projects/punim2997/conda_envs/cfcpose/include/python3.11 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=chamfer -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/data/gpfs/projects/punim2997/conda_envs/cfcpose/lib/python3.11/site-packages/torch/include -I/data/gpfs/projects/punim2997/conda_envs/cfcpose/lib/python3.11/site-packages/torch/include/torch/csrc/api/include -I/data/gpfs/projects/punim2997/conda_envs/cfcpose/lib/python3.11/site-packages/torch/include/TH -I/data/gpfs/projects/punim2997/conda_envs/cfcpose/lib/python3.11/site-packages/torch/include/THC -I/apps/easybuild-2022/easybuild/software/Core/CUDA/12.4.1/include -I/data/gpfs/projects/punim2997/conda_envs/cfcpose/include/python3.11 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=chamfer -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_80,code=sm_80 -ccbin /apps/easybuild-2022/easybuild/software/Core/GCCcore/11.3.0/bin/gcc -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /data/gpfs/projects/punim2997/CFCPose/simeco/extensions/chamfer_dist/build/temp.linux-x86_64-cpython-311/chamfer.o: cuda_compile /data/gpfs/projects/punim2997/CFCPose/simeco/extensions/chamfer_dist/chamfer.cu
build /data/gpfs/projects/punim2997/CFCPose/simeco/extensions/chamfer_dist/build/temp.linux-x86_64-cpython-311/chamfer_cuda.o: compile /data/gpfs/projects/punim2997/CFCPose/simeco/extensions/chamfer_dist/chamfer_cuda.cpp






